			<result name="success" type="redirect">listProd</result>
		</action>
		<action name="listProd" method="prepare" class="com.elmar.view.ProductAction">
			<result name="success">/product.jsp</result>
		</action>
		<!-- <action name="ProductAction" method="list" class="com.elmar.view.ProductAction">
			<result name="success">product.jsp</result>
		</action> -->
		
		<action name="listProdCat" method="listCat" class="com.elmar.view.ProductAction">
			<result name="success">/product.jsp</result>
		</action>
		
		<action name="editProd" method="edit" class="com.elmar.view.ProductAction">
			<result name="success">/Update.jsp</result>
		</action>
