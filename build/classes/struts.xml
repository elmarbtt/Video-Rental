			<result name="success" type="redirect">listUser</result>
		   </action>
			<action name="editUser" method="edit" class="com.elmar.view.UserAction">
			<result name="success">/UpdateUser.jsp</result>
		</action>
		<action name="removeUser" method="delete" class="com.elmar.view.UserAction">
			<result name="success" type="redirect">listUser</result>
		   </action>
		
		
		   
		   
		   
		   
